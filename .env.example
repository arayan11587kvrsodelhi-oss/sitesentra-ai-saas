
# ---------------------------------------------------------------------------
# SiteSentra — environment template
# PLACEHOLDER VALUES ONLY — never put real credentials in this file.
#
# Copy to .env.local for local development:
#   Copy-Item .env.example .env.local
#
# .env, .env.local, and other environment-specific files must remain
# git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local sandbox default only — not a production credential.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Optional Supabase configuration ----------------------------------------
# Public project identifiers. These are not privileged credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Privileged server-only credentials.
# Never expose these through NEXT_PUBLIC_ variables or client-side imports.
# Leave blank when using the local/session-cookie auth implementation.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# --- Authentication session policy (server-only) ----------------------------
# Session lifetime in seconds. Default: 7 days.
SESSION_TTL_SECONDS=604800

# --- Authentication attempt throttling (server-only) -------------------------
# In-process sliding-window limits.
# Limits are per application process, not globally shared across instances.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_PER_WINDOW=10
AUTH_SIGNUP_MAX_PER_WINDOW=20

# --- Scanner abuse limits (server-only) --------------------------------------
# Sliding-window scan quota per signed-in user.
SCAN_RATE_LIMIT_WINDOW_MINUTES=60
SCAN_RATE_LIMIT_MAX_PER_WINDOW=12

# Maximum simultaneous outbound scanner requests per process.
SCANNER_MAX_CONCURRENT_REQUESTS=3

# Maximum wait for an available scanner slot, in milliseconds.
SCANNER_QUEUE_TIMEOUT_MS=10000

# Per-request connection and total timeouts, in milliseconds.
SCANNER_CONNECT_TIMEOUT_MS=5000
SCANNER_TOTAL_TIMEOUT_MS=15000

# Maximum response body size accepted by the scanner, in bytes.
SCANNER_MAX_RESPONSE_BYTES=65536

# --- Integration tests (never configure these in production) -----------------
# Required only for:
#   npm run test:integration
#
# The integration runner reads DATABASE_URL_INTEGRATION only.
# It must never fall back to DATABASE_URL, .env, or .env.local.
#
# Use a disposable, isolated Neon branch — never your production branch.
#
# Set all four values in your local PowerShell session:
#
# $env:DATABASE_URL_INTEGRATION = "postgresql://..."
# $env:INTEGRATION_EXPECTED_ENDPOINT_ID = "ep-xxxx-12345"
# $env:INTEGRATION_EXPECTED_DATABASE_NAME = "your_test_database"
# $env:INTEGRATION_EXPECTED_BRANCH = "your-disposable-branch"
#
# The runner checks the expected database identity and branch marker.
# The branch marker is operator-confirmed; do not treat it as independent
# proof of the provider-side branch identity.
#
# DATABASE_URL_INTEGRATION=
# INTEGRATION_EXPECTED_ENDPOINT_ID=
# INTEGRATION_EXPECTED_DATABASE_NAME=
# INTEGRATION_EXPECTED_BRANCH=
