# ---------------------------------------------------------------------------
# SiteSentra — environment template (PLACEHOLDER VALUES ONLY — no real secrets)
#
# Copy to `.env.local` for local development:  cp .env.example .env.local
# `.env`, `.env.local` and every other `.env.*` file except this one are
# git-ignored. Never commit a file that contains a real credential.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local sandbox default (no password secret — local only):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Supabase path (only used when the app is pointed at Supabase Postgres) ---
# Public, browser-safe values. These are NOT secrets: they identify the project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# PRIVILEGED — server-only. Must never be imported by client code, and must
# never be prefixed with NEXT_PUBLIC_. Leaving these blank keeps the app on the
# local/session-cookie auth implementation in src/lib/auth.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# --- Auth session policy (server-only) ---------------------------------------
# Lifetime of a login session, in seconds. Default: 7 days.
SESSION_TTL_SECONDS=604800

# --- Authentication attempt throttling (server-only) -------------------------
# In-process sliding window bounding login and signup attempts. Buckets are
# keyed by a hashed account identifier AND a hashed client address. See
# src/lib/auth/attempt-limit.ts for the documented per-instance limitation.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_PER_WINDOW=10
AUTH_SIGNUP_MAX_PER_WINDOW=20

# --- Scanner abuse limits (server-only) --------------------------------------
# Sliding-window scan quota per signed-in user.
SCAN_RATE_LIMIT_WINDOW_MINUTES=60
SCAN_RATE_LIMIT_MAX_PER_WINDOW=12
# Hard ceiling on simultaneous outbound scanner requests for the whole process.
SCANNER_MAX_CONCURRENT_REQUESTS=3
# Milliseconds a scan will wait for a free slot before failing closed.
SCANNER_QUEUE_TIMEOUT_MS=10000
# Per-request timeouts.
SCANNER_CONNECT_TIMEOUT_MS=5000
SCANNER_TOTAL_TIMEOUT_MS=15000
# Bytes of response body the scanner will tolerate before aborting the socket.
SCANNER_MAX_RESPONSE_BYTES=65536

# --- Integration tests (never set these in production) -----------------------
# Only needed to run `npm run test:integration`. The suite reads
# DATABASE_URL_INTEGRATION ONLY — it never falls back to DATABASE_URL, .env or
# .env.local — and aborts unless the live database identity matches all three
# declared expectations exactly (no substring matching):
#   INTEGRATION_EXPECTED_ENDPOINT_ID   Neon endpoint id, e.g. ep-xxxx-12345
#   INTEGRATION_EXPECTED_DATABASE_NAME exact database name on that branch
#   INTEGRATION_EXPECTED_BRANCH        branch name written to the marker table
# Point these at a disposable branch. Never at the branch DATABASE_URL uses.
# DATABASE_URL_INTEGRATION=
# INTEGRATION_EXPECTED_ENDPOINT_ID=
# INTEGRATION_EXPECTED_DATABASE_NAME=
# INTEGRATION_EXPECTED_BRANCH=
